model Estate {
  id          String     @id @default(uuid())
  name        String
  address     String
  totalHouses Int
  createdAt   DateTime   @default(now())
  settings    Json?
  residents   Resident[]
  users       User[]
  visitors    Visitor[]
}

model User {
  id String @id @default(uuid())

  email       String   @unique
  password    String
  role        Role
  first_login Boolean  @default(true)
  createdAt   DateTime @default(now())

  estateId String
  estate   Estate    @relation(fields: [estateId], references: [id])
  resident Resident?
  gateLogs GateLog[]
}

model Resident {
  id String @id @default(uuid())

  first_name String
  last_name  String
  email      String @unique
  phone      String
  dob        String
  gender     String
  estateId   String

  userId String? @unique

  status ResidentStatus @default(PENDING)

  house_no        String
  block           String
  home_address    String
  state_of_origin String
  lga             String

  id_type           String
  id_no             String
  id_document_front String
  id_document_back  String
  bvn               String?
  alternate_phone   String?

  next_of_kin_name         String?
  next_of_kin_phone        String?
  next_of_kin_email        String?
  next_of_kin_relationship String?

  guarantor_name                 String
  guarantor_occupation           String
  guarantor_work_address         String
  guarantor_id_no                String
  guarantor_id_relationship      String
  signed_guarantor_letter_upload String

  vehicle_plate_no String
  vehicle_make     String
  vehicle_color    String?

  proof_of_address_upload String
  passport                String
  tenancy_ownership_doc   String

  wallet_pin String?

  ndprConsentDataProcessing Boolean
  ndprConsentIdentity       Boolean
  ndprConsentThirdParty     Boolean
  ndprConsentGivenAt        DateTime?

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  visitors Visitor[]
}

model Visitor {
  id         String        @id @default(uuid())
  estateId   String
  residentId String
  name       String
  phone      String?
  status     VisitorStatus @default(PENDING)
  visitDate  DateTime
  createdAt  DateTime      @default(now())

  estate   Estate    @relation(fields: [estateId], references: [id])
  resident Resident  @relation(fields: [residentId], references: [id])
  gateLogs GateLog[]
}

model GateLog {
  id        String   @id @default(uuid())
  visitorId String
  guardId   String
  action    String // CHECK_IN / CHECK_OUT
  timestamp DateTime @default(now())

  guard   User    @relation(fields: [guardId], references: [id])
  visitor Visitor @relation(fields: [visitorId], references: [id])
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESIDENT
  GUARD
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  CHECKED_IN
  CHECKED_OUT
}

enum ResidentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
}


// // Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuardRole {
  GUARD
  SUPER_GUARD
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESIDENT
  GUARD
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  CHECKED_IN
  CHECKED_OUT
  REVOKED
  EXPIRED
}

enum ResidentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
}

enum GateAction {
  CHECK_IN
  CHECK_OUT
  DENY
}

enum LogCategory {
  VISITOR
  STAFF
  VEHICLE
  SECURITY
  WALLET
  MAINTENANCE
  COMMUNITY
  SYSTEM
}


//   FACILITY
//   EMERGENCY
//   OTHER
// }

enum AlertStatus {
  ACTIVE
  RESOLVED
}

enum TicketPriority {
  P1_CRITICAL
  P2_URGENT
  P3_ROUTINE
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  OVERDUE
  BREACHED
}


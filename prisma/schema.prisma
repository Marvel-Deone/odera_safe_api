enum EmergencyNotificationEvent {
  SOS_TRIGGERED
  ESCALATED
  ALARM_TRIGGERED
  INCIDENT_CLOSED
}

enum EmergencyContactType {
  POLICE
  FIRE_SERVICE
  AMBULANCE
  ESTATE_SECURITY
  OTHER
}

enum EmergencyContactActionType {
  CALL
  SMS
  SUPER_ADMIN_ESCALATION
}

enum PollAudience {
  ALL_RESIDENTS
  LEVY_CLEARED_ONLY
}

enum LevyStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum WalletTransactionType {
  FUNDING
  LEVY_PAYMENT
  VEHICLE_REGISTRATION
  HEAVY_VEHICLE_PASS
  SHORTLET_REGISTRATION
  BUSINESS_REGISTRATION
  WITHDRAWAL
  REFUND
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ResidentReviewAction {
  APPROVE
  REJECT
}

enum ResidentSelfOnboardingStatus {
  PENDING
  ACTIVATED
  EXPIRED
}

enum ShortletStatus {
  INACTIVE
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum BookingStatus {
  PENDING
  ACTIVE
  CHECKED_IN
  COMPLETED
  EXPIRED
  CANCELLED
}

enum AccessType {
  ENTRY
  EXIT
}

enum VehicleStatus {
  PENDING
  ACTIVE
  REJECTED
  PAYMENT_FAILED
  SUSPENDED
}

enum AccessDirection {
  ENTRY
  EXIT
}

enum HeavyVehicleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentOption {
  PAY_NOW
  PAY_ON_ARRIVAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum BusinessPaymentFrequency {
  MONTHLY
  ANNUAL
}

enum BusinessHubStatus {
  ENABLED
  DISABLED
}

enum BusinessCategory {
  CHURCH
  SCHOOL
  RELIGIOUS_ORGANIZATION
  OFFICE
  SHOP
  OTHER
}

enum BusinessRegistrationStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum BusinessPaymentStatus {
  UNPAID
  PAID
  FAILED
  EXPIRED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ResidentAssociateCategory {
  STAFF
  CO_RESIDENT
}

enum NinVerificationStatus {
  NOT_SUBMITTED
  VERIFIED
  FAILED
}

enum AdminSosCategory {
  SECURITY_EMERGENCY
  POLICE_ASSISTANCE
  FIRE_EMERGENCY
  MEDICAL_EMERGENCY
  ESTATE_WIDE_EMERGENCY
  OTHER
}

enum FinanceRecordType {
  INCOME
  EXPENSE
}

enum LevyCategory {
  ADMIN_LEVY
  MONTHLY_RESIDENT_LEVY
}


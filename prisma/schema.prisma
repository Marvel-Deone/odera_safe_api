// // This is your Prisma schema file,
// // learn more about it in the docs: https://pris.ly/d/prisma-schema

// // Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GuardRole {
  GUARD
  SUPER_GUARD
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RESIDENT
  GUARD
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  CHECKED_IN
  CHECKED_OUT
  REVOKED
  EXPIRED
}

enum ResidentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVE
}

enum GateAction {
  CHECK_IN
  CHECK_OUT
  DENY
}

enum LogCategory {
  VISITOR
  STAFF
  VEHICLE
  SECURITY
  WALLET
  MAINTENANCE
  COMMUNITY
  SYSTEM
}

enum GateQueueStatus {
  WAITING
  APPROVED
  DENIED
  COMPLETED
  PROCESSED
}

enum ShiftType {
  DAY
  NIGHT
  STANDBY
  REST
}

enum ShiftStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  MISSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  OFF_DUTY
}

enum ShiftSwapReason {
  PERSONAL_EMERGENCY
  MEDICAL
  FAMILY
  FATIGUE
  OTHER
}

enum ShiftSwapStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GuardSOSCategory {
  INTRUDER
  PHYSICAL_CONFRONTATION
  ARMED_THREAT
  SUSPECT_FLEEING
  PERSONAL_INJURY
  CIVIL_DISTURBANCE
}

enum GuardSOSStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  OVERDUE
  BREACHED
}

enum IncidentCategory {
  SECURITY
  MAINTENANCE
  ACCESS_CONTROL
  COMMUNITY
  DELIVERY
  PARKING
  FACILITY
  EMERGENCY
  OTHER
}


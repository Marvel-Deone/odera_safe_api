model Estate {
  id                        String                     @id @default(uuid())
  name                      String
  address                   String
  totalHouses               Int
  createdAt                 DateTime                   @default(now())
  settings                  Json?
  residents                 Resident[]
  residentSelfOnboardings   ResidentSelfOnboarding[]
  apartmentTypes            ApartmentType[]
  users                     User[]
  visitors                  Visitor[]
  activityLogs              ActivityLog[]
  guards                    Guard[]
  gateQueues                GateQueue[]
  guardShifts               GuardShift[]
  patrolCheckpoints         PatrolCheckpoint[]
  patrolScans               PatrolScan[]
  shiftSwapRequests         ShiftSwapRequest[]
  guardSOSs                 GuardSOS[]
  incidents                 Incident[]
  guardPerformanceSnapshots GuardPerformanceSnapshot[]
  guardLocations            GuardLocation[]
  // maintenanceTickets        MaintenanceTicket[]
  announcements             Announcement[]
  chatRooms                 ChatRoom[]
  polls                     Poll[]
  committees                Committee[]
  levies                    Levy[]
  wallet                    Wallet?
  estateSettings            EstateSettings?
  shortletSettings          ShortletSettings?
  streets                   EstateStreet[]
  heavyVehicleCategories    HeavyVehicleCategory[]
  businessHubSettings       BusinessHubSettings?
  businessRegistrations     BusinessRegistration[]
  emergencyContacts         EmergencyContact[]
  emergencyContactActions   EmergencyContactAction[]
  estateFinanceRecords      EstateFinanceRecord[]
}

model User {
  id String @id @default(uuid())

  email       String   @unique
  password    String
  role        Role
  first_login Boolean  @default(true)
  createdAt   DateTime @default(now())

  estateId                 String
  estate                   Estate                    @relation(fields: [estateId], references: [id])
  resident                 Resident?
  residentAssociate        ResidentAssociate?
  gateLogs                 GateLog[]
  guard                    Guard?
  assignedIncidents        Incident[]                @relation("AssignedIncidentUser")
  announcements            Announcement[]
  announcementComments     AnnouncementComment[]
  announcementLikes        AnnouncementLike[]
  chatMessages             ChatMessage[]
  polls                    Poll[]
  pollVotes                PollVote[]
  committeeMembers         CommitteeMember[]
  createdLevies            Levy[]
  approvedWithdrawals      WithdrawalRequest[]       @relation("WithdrawalApprover")
  approvedVehicles         Vehicle[]                 @relation("VehicleApprover")
  approvedHeavyVehicles    HeavyVehiclePass[]        @relation("HeavyVehicleApprover")
  shortletAccessLogs       ShortletAccessLog[]       @relation("ShortletAccessVerifier")
  businessAccessLogs       BusinessAccessLog[]
  incidentChatParticipants IncidentChatParticipant[]
  emergencyNotifications   EmergencyNotification[]
  emergencyContactActions  EmergencyContactAction[]
  incidentTimelineEntries  IncidentTimelineEntry[]
  estateFinanceRecords     EstateFinanceRecord[]
  passwordResetOtps        PasswordResetOtp[]
}

model PasswordResetOtp {
  id     String @id @default(cuid())
  userId String

  otpHash   String
  expiresAt DateTime

  verified Boolean @default(false)
  attempts Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Resident {
  id String @id @default(uuid())

  first_name String
  last_name  String
  email      String  @unique
  phone      String
  dob        String?
  gender     String?
  estateId   String
  streetId   String?
  apartmentTypeId String?

  userId String? @unique

  status          ResidentStatus @default(PENDING)
  kycStatus       KycStatus      @default(NOT_SUBMITTED)
  rejectionReason String?
  face_capture    String?

  house_no        String
  block           String?
  home_address    String?
  state_of_origin String?
  lga             String?

  id_type           String?
  id_no             String?
  id_document_front String?
  id_document_back  String?
  nin               String?
  bvn               String?
  alternate_phone   String?

  next_of_kin_name         String?
  next_of_kin_phone        String?
  next_of_kin_email        String?
  next_of_kin_relationship String?

  guarantor_name                 String?
  guarantor_occupation           String?
  guarantor_work_address         String?
  guarantor_id_no                String?
  guarantor_id_relationship      String?
  signed_guarantor_letter_upload String?

  vehicle_plate_no String?
  vehicle_make     String?
  vehicle_color    String?

  proof_of_address_upload String?
  passport                String?
  tenancy_ownership_doc   String?

  wallet_pin String?

  ndprConsentDataProcessing Boolean   @default(false)
  ndprConsentIdentity       Boolean   @default(false)
  ndprConsentThirdParty     Boolean   @default(false)
  ndprConsentGivenAt        DateTime?

  levyCleared        Boolean @default(false)
  profileDeclaration Boolean @default(false)

  approvedAt DateTime?
  rejectedAt DateTime?

  activationCodeExpiresAt DateTime?
  activatedAt             DateTime?

  createdAt DateTime @default(now())

  estate                Estate                 @relation(fields: [estateId], references: [id])
  street                EstateStreet?          @relation(fields: [streetId], references: [id])
  apartmentType         ApartmentType?         @relation(fields: [apartmentTypeId], references: [id])
  user                  User?                  @relation(fields: [userId], references: [id])
  visitors              Visitor[]
  incidents             Incident[]
  wallet                Wallet?
  levyAssignments       LevyAssignment[]
  withdrawalRequests    WithdrawalRequest[]
  shortletProperties    ShortletProperty[]
  vehicles              Vehicle[]
  heavyVehiclePasses    HeavyVehiclePass[]
  businessRegistrations BusinessRegistration[]
  residentAssociates    ResidentAssociate[]

  @@index([apartmentTypeId])
}

model ResidentSelfOnboarding {
  id String @id @default(uuid())

  estateId String

  fullName        String
  houseNumber     String
  residentAddress String
  whatsappPhone   String @unique
  email           String @unique

  activationCodeHash      String
  activationCodeExpiresAt DateTime
  activatedAt             DateTime?

  status ResidentSelfOnboardingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@index([estateId, status])
  @@index([whatsappPhone])
}

model ResidentAssociate {
  id                    String                    @id @default(uuid())
  residentId            String
  userId                String?                   @unique
  category              ResidentAssociateCategory @default(CO_RESIDENT)
  fullName              String
  email                 String?                   @unique
  phoneNumber           String
  role                  String                    @default("Co-resident")
  idType                String?
  idNumber              String?
  faceCapture           String?
  workingDays           Weekday[]
  entryTime             String?
  exitTime              String?
  passcode              String?                   @unique
  qrPayload             String?                   @unique
  qrCode                String?
  ninVerificationStatus NinVerificationStatus     @default(NOT_SUBMITTED)
  ninVerificationData   Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([residentId])
  @@index([userId])
  @@index([category])
  @@index([ninVerificationStatus])
  @@index([qrPayload])
}

model EstateStreet {
  id        String   @id @default(uuid())
  estateId  String
  name      String
  createdAt DateTime @default(now())

  estate    Estate     @relation(fields: [estateId], references: [id], onDelete: Cascade)
  residents Resident[]
  chatRooms ChatRoom[]

  @@unique([estateId, name])
  @@index([estateId])
}

model EstateSettings {
  id                      String   @id @default(uuid())
  estateId                String   @unique
  freeVehicleLimit        Int      @default(1)
  vehicleRegistrationFee  Decimal  @default(0)
  applyKycLevyGracePeriod Boolean  @default(true)
  applyApartmentType      Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model ApartmentType {
  id        String   @id @default(uuid())
  estateId  String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate      Estate                    @relation(fields: [estateId], references: [id], onDelete: Cascade)
  residents   Resident[]
  levyPrices  LevyApartmentTypePrice[]

  @@unique([estateId, name])
  @@index([estateId, active])
}

model HeavyVehicleCategory {
  id          String   @id @default(uuid())
  estateId    String
  name        String
  description String?
  amount      Decimal
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  estate Estate             @relation(fields: [estateId], references: [id], onDelete: Cascade)
  passes HeavyVehiclePass[]

  @@unique([estateId, name])
  @@index([estateId, active])
}

model ShortletSettings {
  id                    String   @id @default(uuid())
  estateId              String   @unique
  annualRegistrationFee Decimal  @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model BusinessHubSettings {
  id                 String                   @id @default(uuid())
  estateId           String                   @unique
  registrationFee    Decimal                  @default(0)
  paymentFrequency   BusinessPaymentFrequency @default(ANNUAL)
  maxVehiclesAllowed Int                      @default(1)
  status             BusinessHubStatus        @default(DISABLED)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model BusinessRegistration {
  id                 String                     @id @default(uuid())
  estateId           String
  residentId         String
  name               String?
  category           BusinessCategory
  otherCategory      String?
  validDays          Weekday[]
  startTime          String
  endTime            String
  maxVehiclesAllowed Int
  registrationFee    Decimal
  paymentFrequency   BusinessPaymentFrequency
  registrationStatus BusinessRegistrationStatus @default(DRAFT)
  paymentStatus      BusinessPaymentStatus      @default(UNPAID)
  paidAt             DateTime?
  expiresAt          DateTime?
  suspendedAt        DateTime?
  suspensionReason   String?
  passcode           String                     @unique
  qrPayload          String                     @unique
  qrCode             String
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  estate     Estate              @relation(fields: [estateId], references: [id], onDelete: Cascade)
  resident   Resident            @relation(fields: [residentId], references: [id], onDelete: Cascade)
  payments   BusinessPayment[]
  accessLogs BusinessAccessLog[]

  @@index([estateId, registrationStatus])
  @@index([residentId])
  @@index([paymentStatus])
}

model BusinessPayment {
  id             String                @id @default(uuid())
  registrationId String
  amount         Decimal
  status         BusinessPaymentStatus
  reference      String                @unique
  paidAt         DateTime?
  createdAt      DateTime              @default(now())

  registration BusinessRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@index([status])
}

model BusinessAccessLog {
  id             String   @id @default(uuid())
  registrationId String?
  passcode       String?
  qrPayload      String?
  gateName       String
  vehiclePlate   String?
  verifiedById   String?
  allowed        Boolean
  deniedReason   String?
  createdAt      DateTime @default(now())

  registration BusinessRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  verifiedBy   User?                 @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([registrationId])
  @@index([verifiedById])
  @@index([createdAt])
}

model EstateFinanceRecord {
  id String @id @default(cuid())

  estateId     String
  recordedById String

  type        FinanceRecordType
  category    String?
  description String
  amount      Decimal           @db.Decimal(15, 2)
  recordedAt  DateTime          @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate     Estate @relation(fields: [estateId], references: [id])
  recordedBy User   @relation(fields: [recordedById], references: [id])

  @@index([estateId])
  @@index([estateId, type])
  @@index([recordedAt])
}

model Guard {
  id       String @id @default(uuid())
  userId   String @unique
  estateId String

  role GuardRole

  full_name String
  phone     String
  email     String?

  zone_assignment String?
  shift_pattern   String?
  duty_cycle      String?

  resumption_date DateTime?

  // IDENTITY
  government_id_type String?
  government_id_no   String?
  nin                String?

  height               String?
  build                String?
  distinguishing_marks String?

  id_document_url String?

  // NEXT OF KIN
  nok_name         String?
  nok_phone        String?
  nok_relationship String?

  // GUARANTOR
  guarantor_name         String?
  guarantor_phone        String?
  guarantor_occupation   String?
  guarantor_work_address String?
  guarantor_nin          String?
  guarantor_relationship String?
  guarantor_letter_url   String?

  // CERTIFICATIONS
  first_aid         Boolean @default(false)
  fire_safety       Boolean @default(false)
  qr_gate_ops       Boolean @default(false)
  biometric_capture Boolean @default(false)
  crisis_response   Boolean @default(false)
  female_screening  Boolean @default(false)
  self_defence      Boolean @default(false)
  cctv_operation    Boolean @default(false)

  // PAYROLL
  salary_band    String?
  bank_name      String?
  account_number String?
  account_name   String?

  passport_photo_url String?

  is_active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  assignedIncidents Incident[] @relation("AssignedIncidentGuard")
  reportedIncidents Incident[] @relation("ReportedIncidents")

  gateLogs                  GateLog[]
  guardShifts               GuardShift[]
  guardAttendances          GuardAttendance[]
  patrolScans               PatrolScan[]
  shiftSwapRequests         ShiftSwapRequest[]
  SwapRequester             ShiftSwapRequest[]         @relation("SwapRequester")
  SwapRecipient             ShiftSwapRequest[]         @relation("SwapRecipient")
  guardSOSs                 GuardSOS[]
  patrolAlerts              PatrolAlert[]
  missedCheckpointAlerts    MissedCheckpointAlert[]
  guardPerformanceSnapshots GuardPerformanceSnapshot[]
  locations                 GuardLocation[]
  // maintenanceTickets        MaintenanceTicket[]
}

model Visitor {
  id String @id @default(uuid())

  estateId   String
  residentId String

  name                   String
  phone                  String?
  purpose                String?
  plate_no               String?
  hasAccompanyingVisitor Boolean @default(false)
  accompanyingVisitors   Json    @default("[]")

  visit_date DateTime @default(now())

  // PASS CONTROL
  total_entries     Int
  remaining_entries Int

  status VisitorStatus @default(PENDING)

  // PASS SECURITY
  passCode  String   @unique
  qr_code   String?
  sms_code  String   @unique
  expiresAt DateTime

  // GPS LOCK (for your future feature)
  gps_lat Float?
  gps_lng Float?

  // BIOMETRIC FLAG
  biometric_enabled  Boolean @default(false)
  biometric_fee_paid Boolean @default(false)

  // TRACKING
  checkedInAt  DateTime?
  checkedOutAt DateTime?

  createdAt DateTime @default(now())

  estate   Estate   @relation(fields: [estateId], references: [id])
  resident Resident @relation(fields: [residentId], references: [id])

  gateLogs         GateLog[]
  visitorLocations VisitorLocation[]
  trackingSessions TrackingSession[]
  gateQueues       GateQueue[]
}

model TrackingSession {
  id String @id @default(cuid())

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id])

  token String @unique

  isActive Boolean @default(true)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations      VisitorLocation[]
  currentLat     Float?
  currentLng     Float?
  lastLocationAt DateTime?

  @@index([visitorId])
  @@index([isActive])
  @@index([visitorId, isActive])
}

model VisitorLocation {
  id String @id @default(cuid())

  trackingSessionId String

  trackingSession TrackingSession @relation(fields: [trackingSessionId], references: [id])

  latitude  Float
  longitude Float
  accuracy  Float?

  createdAt DateTime @default(now())
  visitor   Visitor? @relation(fields: [visitorId], references: [id])
  visitorId String?

  @@index([visitorId])
  @@index([createdAt])
  @@index([trackingSessionId, createdAt])
}

model GateLog {
  id        String     @id @default(uuid())
  visitorId String
  guardId   String
  action    GateAction

  createdAt DateTime @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id])
  guard   Guard   @relation(fields: [guardId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  userId  String?
}

model ActivityLog {
  id String @id @default(uuid())

  estateId String

  category LogCategory
  action   String

  description String

  actorId   String?
  actorRole Role?

  metadata Json?

  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id])
}

model GateQueue {
  id String @id @default(uuid())

  estateId  String
  visitorId String

  status GateQueueStatus @default(WAITING)

  scannedAt   DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate  Estate  @relation(fields: [estateId], references: [id])
  visitor Visitor @relation(fields: [visitorId], references: [id])

  @@unique([visitorId, status])
}

model GuardShift {
  id       String @id @default(uuid())
  guardId  String
  estateId String

  // Date this shift starts
  shiftDate DateTime

  // Shift configuration
  shiftType ShiftType // DAY, NIGHT, STANDBY, REST
  startTime DateTime?
  endTime   DateTime?
  zone      String?

  // Status
  status ShiftStatus @default(SCHEDULED)

  // Optional notes
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guard  Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)
  estate Estate @relation(fields: [estateId], references: [id])

  attendance             GuardAttendance?
  patrolScans            PatrolScan[]
  requesterShiftRequests ShiftSwapRequest[] @relation("RequesterShift")
  targetShiftRequests    ShiftSwapRequest[] @relation("TargetShift")
  shiftSwapRequests      ShiftSwapRequest[]

  @@index([guardId, shiftDate])
  @@index([estateId, shiftDate])
}

model GuardAttendance {
  id      String @id @default(uuid())
  shiftId String @unique
  guardId String

  // Clock-in
  clockInAt        DateTime?
  clockInLatitude  Float?
  clockInLongitude Float?
  clockInPhotoUrl  String?

  // Clock-out
  clockOutAt        DateTime?
  clockOutLatitude  Float?
  clockOutLongitude Float?
  clockOutPhotoUrl  String?

  // Operational notes
  handoverNotes String?

  // Metrics
  minutesLate      Int              @default(0)
  minutesWorked    Int              @default(0)
  overtimeMinutes  Int              @default(0)
  attendanceStatus AttendanceStatus @default(PRESENT)

  status AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shift GuardShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  guard Guard      @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@index([guardId, clockInAt])
}

model PatrolCheckpoint {
  id       String @id @default(uuid())
  estateId String

  name        String
  qrCode      String?
  zone        String
  description String?

  latitude  Float?
  longitude Float?

  requiredFrequency Int // e.g. every 2 hours
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  estate Estate @relation(fields: [estateId], references: [id])

  scans                  PatrolScan[]
  patrolAlerts           PatrolAlert[]
  missedCheckpointAlerts MissedCheckpointAlert[]

  @@index([estateId, zone])
}

model PatrolScan {
  id           String  @id @default(uuid())
  guardId      String
  checkpointId String
  shiftId      String?
  estateId     String

  scannedAt DateTime @default(now())

  latitude  Float?
  longitude Float?

  // Validation
  isValid          Boolean @default(true)
  distanceFromSite Float? // meters
  notes            String?

  // Relations
  guard      Guard            @relation(fields: [guardId], references: [id], onDelete: Cascade)
  checkpoint PatrolCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  shift      GuardShift?      @relation(fields: [shiftId], references: [id])
  estate     Estate           @relation(fields: [estateId], references: [id])

  @@index([guardId, scannedAt])
  @@index([checkpointId, scannedAt])
}

model PatrolAlert {
  id           String  @id @default(uuid())
  estateId     String
  checkpointId String?
  guardId      String?
  type         String
  message      String
  resolved     Boolean @default(false)

  createdAt DateTime @default(now())

  checkpoint PatrolCheckpoint? @relation(fields: [checkpointId], references: [id])
  guard      Guard?            @relation(fields: [guardId], references: [id])
}

model ShiftSwapRequest {
  id String @id @default(uuid())

  requesterGuardId String
  targetGuardId    String

  requesterShiftId String
  targetShiftId    String

  estateId String

  reason  ShiftSwapReason
  details String?

  status ShiftSwapStatus @default(PENDING)

  reviewedBy String? // userId of Super-Guard/Admin
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  requester Guard @relation("SwapRequester", fields: [requesterGuardId], references: [id], onDelete: Cascade)

  target Guard @relation("SwapRecipient", fields: [targetGuardId], references: [id], onDelete: Cascade)

  requesterShift GuardShift @relation("RequesterShift", fields: [requesterShiftId], references: [id], onDelete: Cascade)

  targetShift GuardShift @relation("TargetShift", fields: [targetShiftId], references: [id], onDelete: Cascade)

  estate       Estate      @relation(fields: [estateId], references: [id])
  guard        Guard?      @relation(fields: [guardId], references: [id])
  guardId      String?
  guardShift   GuardShift? @relation(fields: [guardShiftId], references: [id])
  guardShiftId String?

  @@index([estateId, status])
  @@index([requesterGuardId, status])
  @@index([targetGuardId, status])
}

model GuardSOS {
  id String @id @default(uuid())

  guardId    String
  estateId   String
  incidentId String? @unique

  category GuardSOSCategory
  zone     String?
  message  String?

  latitude  Float?
  longitude Float?

  status GuardSOSStatus @default(ACTIVE)

  acknowledgedAt DateTime?
  acknowledgedBy String?

  resolvedBy     String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guard    Guard     @relation(fields: [guardId], references: [id], onDelete: Cascade)
  estate   Estate    @relation(fields: [estateId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([guardId, createdAt])
  @@index([status, createdAt])
  @@index([incidentId])
}

model Incident {
  id       String @id @default(uuid())
  estateId String

  reportedByResidentId String?
  reportedByGuardId    String?

  title       String
  category    IncidentCategory
  description String
  severity    IncidentSeverity
  priority    TicketPriority?

  photos     Json?
  occurredAt DateTime @default(now())

  status        IncidentStatus @default(OPEN)
  adminNotes    String?
  materialsUsed String?
  timeTaken     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location String?

  beforePhotos Json?
  afterPhotos  Json?

  assignedToGuardId String?
  assignedToUserId  String?

  slaDeadline DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  completionNote String?
  residentRating Int?
  silencedAt     DateTime?
  silencedBy     String?

  estate Estate @relation(fields: [estateId], references: [id])

  reportedByResident Resident? @relation(fields: [reportedByResidentId], references: [id])

  reportedByGuard Guard? @relation("ReportedIncidents", fields: [reportedByGuardId], references: [id])

  assignedToGuard Guard? @relation("AssignedIncidentGuard", fields: [assignedToGuardId], references: [id])

  assignedToUser          User?                    @relation("AssignedIncidentUser", fields: [assignedToUserId], references: [id])
  guardSos                GuardSOS?
  timeline                IncidentTimelineEntry[]
  chatRoom                ChatRoom?
  notifications           EmergencyNotification[]
  emergencyContactActions EmergencyContactAction[]

  @@index([estateId])
  @@index([category])
}

model IncidentTimelineEntry {
  id String @id @default(uuid())

  incidentId String
  event      IncidentTimelineEvent
  actorId    String?
  actorRole  Role?
  note       String?
  location   String?
  metadata   Json?

  createdAt DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([event])
}

model MissedCheckpointAlert {
  id String @id @default(cuid())

  estateId String

  checkpointId String
  checkpoint   PatrolCheckpoint @relation(fields: [checkpointId], references: [id])

  guardId String?
  guard   Guard?  @relation(fields: [guardId], references: [id])

  expectedAt DateTime
  resolvedAt DateTime?

  status AlertStatus @default(ACTIVE)

  createdAt DateTime @default(now())
}

model GuardPerformanceSnapshot {
  id String @id @default(uuid())

  guardId  String
  estateId String

  periodStart DateTime
  periodEnd   DateTime

  attendanceScore Float @default(0)
  patrolScore     Float @default(0)
  sosScore        Float @default(0)
  incidentScore   Float @default(0)
  swapScore       Float @default(0)
  penaltyScore    Float @default(0)

  totalScore Float @default(0)
  rank       Int?

  badge String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guard  Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)
  estate Estate @relation(fields: [estateId], references: [id])

  @@index([guardId, periodStart])
  @@index([estateId, periodStart])
  @@index([totalScore])
}

model GuardLocation {
  id String @id @default(uuid())

  guardId  String
  estateId String

  latitude  Float
  longitude Float

  speed   Float?
  heading Float?

  batteryLevel Int?

  recordedAt DateTime @default(now())

  guard  Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)
  estate Estate @relation(fields: [estateId], references: [id])

  @@index([guardId, recordedAt])
  @@index([estateId, recordedAt])
}

model Announcement {
  id String @id @default(uuid())

  estateId String
  authorId String

  title String
  body  String

  category AnnouncementCategory
  audience AnnouncementAudience

  isPinned Boolean @default(false)
  sendSms  Boolean @default(false)

  likesCount    Int @default(0)
  commentsCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate Estate @relation(fields: [estateId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  comments AnnouncementComment[]
  likes    AnnouncementLike[]

  @@index([estateId])
  @@index([createdAt])
}

model AnnouncementComment {
  id String @id @default(uuid())

  announcementId String
  userId         String

  comment String

  createdAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([announcementId])
}

model AnnouncementLike {
  id String @id @default(uuid())

  announcementId String
  userId         String

  createdAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model ChatRoom {
  id String @id @default(uuid())

  estateId   String
  streetId   String?
  incidentId String? @unique

  name String
  type ChatRoomType

  block    String?
  closedAt DateTime?

  createdAt DateTime @default(now())

  estate   Estate        @relation(fields: [estateId], references: [id])
  street   EstateStreet? @relation(fields: [streetId], references: [id])
  incident Incident?     @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  messages     ChatMessage[]
  participants IncidentChatParticipant[]

  @@index([estateId, block])
  @@index([estateId, type])
  @@index([streetId])
  @@index([incidentId])
}

model IncidentChatParticipant {
  id String @id @default(uuid())

  roomId String
  userId String

  createdAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model EmergencyNotification {
  id String @id @default(uuid())

  incidentId  String
  recipientId String
  event       EmergencyNotificationEvent
  deliveredAt DateTime                   @default(now())
  metadata    Json?

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([incidentId, recipientId, event])
  @@index([recipientId, deliveredAt])
}

model EmergencyContact {
  id String @id @default(uuid())

  estateId  String
  name      String
  type      EmergencyContactType
  phone     String
  smsPhone  String?
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  estate  Estate                   @relation(fields: [estateId], references: [id], onDelete: Cascade)
  actions EmergencyContactAction[]

  @@index([estateId, isActive])
}

model EmergencyContactAction {
  id String @id @default(uuid())

  estateId    String
  incidentId  String?
  contactId   String?
  actorId     String
  action      EmergencyContactActionType
  destination String
  note        String?
  metadata    Json?
  createdAt   DateTime                   @default(now())

  estate   Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  incident Incident?         @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  contact  EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  actor    User              @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([estateId, createdAt])
  @@index([incidentId])
}

model ChatMessage {
  id String @id @default(uuid())

  roomId   String
  senderId String

  message String

  createdAt DateTime @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  sender User @relation(fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
  @@index([createdAt])
}

model ChatReadReceipt {
  id String @id @default(uuid())

  userId String
  roomId String

  lastReadAt DateTime

  @@unique([userId, roomId])
}

model Poll {
  id String @id @default(uuid())

  estateId    String
  createdById String

  question String

  audience PollAudience @default(ALL_RESIDENTS)
  isClosed Boolean      @default(false)

  expiresAt DateTime?

  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id])

  options PollOption[]
  votes   PollVote[]

  @@index([estateId])
}

model PollOption {
  id String @id @default(uuid())

  pollId String

  text String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id String @id @default(uuid())

  pollId   String
  optionId String

  userId String

  createdAt DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
  @@index([pollId])
  @@index([userId])
}

model Committee {
  id          String   @id @default(uuid())
  estateId    String
  name        String
  description String?
  createdAt   DateTime @default(now())

  estate  Estate            @relation(fields: [estateId], references: [id], onDelete: Cascade)
  members CommitteeMember[]
}

model CommitteeMember {
  id          String   @id @default(uuid())
  committeeId String
  userId      String
  createdAt   DateTime @default(now())

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([committeeId, userId])
}

model Levy {
  id String @id @default(uuid())

  estateId    String
  createdById String

  title       String
  description String?
  // category    String  @default("CUSTOM")
  category    LevyCategory
  period      String?

  amount Decimal

  dueDate DateTime

  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)

  createdBy User @relation(fields: [createdById], references: [id])

  assignments           LevyAssignment[]
  apartmentTypePrices   LevyApartmentTypePrice[]

  @@unique([estateId, category, period])
  @@index([estateId])
}

model LevyApartmentTypePrice {
  id              String  @id @default(uuid())
  levyId          String
  apartmentTypeId String
  amount          Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levy          Levy          @relation(fields: [levyId], references: [id], onDelete: Cascade)
  apartmentType ApartmentType @relation(fields: [apartmentTypeId], references: [id])

  @@unique([levyId, apartmentTypeId])
  @@index([apartmentTypeId])
}

model LevyAssignment {
  id String @id @default(uuid())

  levyId     String
  residentId String

  amount    Decimal
  headCount Int     @default(1)

  status LevyStatus @default(PENDING)

  paidAmount Decimal @default(0)

  paidAt DateTime?

  levy Levy @relation(fields: [levyId], references: [id], onDelete: Cascade)

  resident           Resident            @relation(fields: [residentId], references: [id])
  walletTransactions WalletTransaction[]

  @@unique([levyId, residentId])
  @@index([residentId])
}

model Wallet {
  id String @id @default(uuid())

  residentId String? @unique
  estateId   String? @unique

  balance Decimal @default(0)

  pinHash String?

  paystackCustomerCode String?

  virtualAccountNumber String?
  virtualAccountName   String?
  virtualBankName      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resident Resident? @relation(fields: [residentId], references: [id])
  estate   Estate?   @relation(fields: [estateId], references: [id])

  transactions WalletTransaction[]
}

model WalletTransaction {

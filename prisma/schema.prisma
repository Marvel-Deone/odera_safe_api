  bankName      String
  accountName   String
  accountNumber String

  status WithdrawalStatus @default(PENDING)

  rejectionReason String?

  approvedById String?

  createdAt DateTime @default(now())

  approvedAt DateTime?
  paidAt     DateTime?

  resident Resident @relation(fields: [residentId], references: [id])

